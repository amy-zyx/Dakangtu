{
  "1": {
    "inputs": {
      "image": "example.png"
    },
    "class_type": "LoadImage",
    "_meta": {"title": "Load Image (原图)"}
  },
  "2": {
    "inputs": {
      "model": " grounding-dino-tiny.safetensors"
    },
    "class_type": "GroundingDinoModelLoader",
    "_meta": {"title": "Load GroundingDINO"}
  },
  "3": {
    "inputs": {
      "prompt": "red dress",
      "image": ["1", 0],
      "grounding_dino_model": ["2", 0]
    },
    "class_type": "GroundingDinoDetect",
    "_meta": {"title": "GroundingDINO Detect (text -> bbox)"}
  },
  "4": {
    "inputs": {
      "model": "sam2.1_hiera_small.safetensors"
    },
    "class_type": "SAM2ModelLoader",
    "_meta": {"title": "Load SAM2"}
  },
  "5": {
    "inputs": {
      "image": ["1", 0],
      "sam2_model": ["4", 0],
      "bboxes": ["3", 0]
    },
    "class_type": "SAM2Segment",
    "_meta": {"title": "SAM2 Segment (bbox -> mask)"}
  },
  "6": {
    "inputs": {
      "unet_name": "z_image_turbo_bf16.safetensors"
    },
    "class_type": "UNETLoader",
    "_meta": {"title": "Load z-image DiT"}
  },
  "7": {
    "inputs": {
      "text_encoder_name": "qwen_3_4b.safetensors",
      "type": "qwen_image"
    },
    "class_type": "CLIPLoader",
    "_meta": {"title": "Load Qwen3 4B (qwen_image type)"}
  },
  "8": {
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {"title": "Load z-image VAE"}
  },
  "9": {
    "inputs": {
      "text": "same girl, same composition, elegant blue silk qipao dress, 2d anime style, masterpiece, best quality",
      "clip": ["7", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "CLIPTextEncode (Positive, 描述目标效果)"}
  },
  "10": {
    "inputs": {
      "text": "blurry, deformed, lowres, bad anatomy, worst quality, text, watermark, modern style, photorealistic, 3d render",
      "clip": ["7", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "CLIPTextEncode (Negative)"}
  },
  "11": {
    "inputs": {
      "pixels": ["1", 0],
      "vae": ["8", 0]
    },
    "class_type": "VAEEncode",
    "_meta": {"title": "VAE Encode (全图)"}
  },
  "12": {
    "inputs": {
      "samples": ["11", 0],
      "mask": ["5", 0]
    },
    "class_type": "SetLatentNoiseMask",
    "_meta": {"title": "Set Latent Noise Mask (按 SAM2 mask 置 noise)"}
  },
  "13": {
    "inputs": {
      "seed": 42,
      "steps": 10,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.7,
      "model": ["6", 0],
      "positive": ["9", 0],
      "negative": ["10", 0],
      "latent_image": ["12", 0]
    },
    "class_type": "KSampler",
    "_meta": {"title": "KSampler (denoise 0.7 = 局部精修)"}
  },
  "14": {
    "inputs": {
      "samples": ["13", 0],
      "vae": ["8", 0]
    },
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"}
  },
  "15": {
    "inputs": {
      "filename_prefix": "zimage_inpaint_auto",
      "images": ["14", 0]
    },
    "class_type": "SaveImage",
    "_meta": {"title": "Save Image"}
  }
}
